{
  "name": "@mi/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./domain": "./src/domain/index.ts",
    "./domain/tokens": "./src/domain/tokens.ts",
    "./queries": "./src/queries/index.ts",
